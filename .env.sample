# Copy to .env and fill in. .env is git-ignored: never commit secrets.
# Empty values are treated as unset.

# Passphrase for the SSH private key at server.ssh.identity_file.
# Leave empty when the key has no passphrase.
PASSALONG_SSH_KEY_PASSPHRASE=

# Optional path to config.toml, overriding the default lookup order
# (see docs/configuration.md).
PASSALONG_CONFIG_FILE=

# Optional log level override: error | warning | info | verbose | debug
PASSALONG_LOG_LEVEL=

# Tests against a deployed passalong-server (`just test-deployed`; see
# docs/developer-guide.md, "Deployed server tests"). None of these is read
# by passalong itself. The two keys are secrets.
INTEGRATION_TEST_SERVER_URL=https://box.example:8443
# Other URLs the certificate names, comma-separated; may be empty.
INTEGRATION_TEST_SERVER_ALT_URLS=https://192.0.2.10:8443
# `passalong-server tls fingerprint` on the server.
INTEGRATION_TEST_TLS_PIN=sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# A workspace made for the tests; never a workspace devices use.
INTEGRATION_TEST_WORKSPACE=integration-test
# `key create --workspace integration-test --label integration-test --never`
INTEGRATION_TEST_API_KEY=pal_000000000000_example
# The same with `--read-only`.
INTEGRATION_TEST_API_KEY_READ_ONLY=pal_000000000000_example
# Where the admin commands run, for the tests that need them:
# `ssh $INTEGRATION_TEST_SSH_HOST`, then `docker compose exec -T server
# passalong-server ...` in INTEGRATION_TEST_SSH_COMPOSE_DIR. Leave both
# empty to skip those tests.
INTEGRATION_TEST_SSH_HOST=
INTEGRATION_TEST_SSH_COMPOSE_DIR=
