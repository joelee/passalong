# Copy to .env next to compose.yaml. Docker Compose reads it automatically.

# Owner of the stored files on the host: run `id -u` and `id -g`.
PUID=1000
PGID=1000

# Where items are stored on the host. Default: ./storage next to compose.yaml.
PASSALONG_STORAGE=./storage

# Port clients connect to. Default: 2222.
PASSALONG_SSH_PORT=2222

TZ=Etc/UTC
